<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101827">
  <title>Contact Us | Roaya Optics</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;
      font-family:Arial,Tahoma,sans-serif;background:linear-gradient(145deg,#101827,#1e293b);color:#fff}
    main{width:min(100%,410px);padding:34px 25px;border:1px solid #ffffff20;border-radius:24px;
      background:#ffffff0d;box-shadow:0 20px 60px #0005;text-align:center}
    .mark{width:66px;height:66px;margin:0 auto 18px;border-radius:20px;display:grid;place-items:center;
      background:#d9b76b;color:#172033;font-size:28px;font-weight:bold}
    h1{font-size:27px;margin:0 0 9px}
    p{color:#cbd5e1;line-height:1.7;margin:0 0 27px}
    a{display:flex;align-items:center;justify-content:center;gap:12px;padding:16px;margin-top:13px;
      border-radius:14px;text-decoration:none;font-size:17px;font-weight:700;transition:transform .15s}
    a:hover{transform:translateY(-2px)}
    .wa{background:#25D366;color:#082b17}
    .mail{background:#f8fafc;color:#172033}
    .icon{font-size:22px}
    footer{margin-top:25px;color:#94a3b8;font-size:12px}
  </style>
</head>
<body>
  <main>
    <div class="mark">R</div>
    <h1>Contact Us</h1>
    <p>We'd love to hear from you. Choose your preferred way to reach us:</p>
    <a class="wa" href="https://wa.me/201101607543" target="_blank" rel="noopener">
      <span class="icon">◉</span> Contact via WhatsApp
    </a>
    <a class="mail" href="mailto:Roayaoptics2018@gmail.com">
      <span class="icon">✉</span> Contact via Gmail
    </a>
    <footer>Roaya Optics</footer>
  </main>
</body>
</html>
